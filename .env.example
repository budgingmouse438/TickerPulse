# Copy this file to .env and fill in real values. Never commit .env.

# Alpaca API credentials (paper/free tier)
# https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Alpaca REST/data endpoints (defaults shown for paper trading + IEX feed)
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex

# Backend server config
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SQLITE_PATH=./data/tickerpulse.sqlite

# Set to "true" only when running behind a reverse proxy (nginx/Caddy/hosting
# platform) that terminates TLS, so Express trusts X-Forwarded-* headers.
TRUST_PROXY=false

# Auth / session config
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SIGNING_SECRET=
# Exact origin of the frontend (no trailing slash), used for CORS lockdown.
FRONTEND_ORIGIN=http://localhost:5173
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Alpaca free/Basic plan safety margins (see SECURITY.md)
ALPACA_ACTIVE_SYMBOL_CAP=25
ALPACA_REST_BUDGET_PER_MIN=150
ACTIVE_IDLE_TIMEOUT_SEC=60
MAX_WATCHLIST_SIZE=50
